<?php
/**
 * @var Omeka\Api\Representation\ItemSetRepresentation $itemSet
 * @var string $year
 * @var string $prevYear
 * @var string $nextYear
 */
?>
<nav class="item-set-calendar-years-navigation" role="navigation">
    <?php if ($prevYear): ?>
        <a href="<?= $this->url(null, [], ['query' => ['year' => $prevYear]], true) ?>" class="previous button" title="<?= $this->escapeHtml($this->translate('Previous')) ?>" aria-label="<?= $this->escapeHtml($this->translate('Previous')) ?>">
            <i class="fas fa-angle-left"></i>
            <?= $this->escapeHtml($prevYear) ?>
        </a>
    <?php endif; ?>

    <?php if ($nextYear): ?>
        <a href="<?= $this->url(null, [], ['query' => ['year' => $nextYear]], true) ?>" class="next button" title="<?= $this->escapeHtml($this->translate('Next')) ?>" aria-label="<?= $this->escapeHtml($this->translate('Next')) ?>">
            <?= $this->escapeHtml($nextYear) ?>
            <i class="fas fa-angle-right"></i>
        </a>
    <?php endif; ?>
</nav>
